# Copiar como ".env" y completar. El .env NO va al repo: lleva la clave del
# broker y la URI de Atlas en texto plano, igual que esp32/include/secrets.h.

PORT=4000

# --- Mongo ---
# Local (docker compose up -d) o la URI de Atlas en produccion.
MONGO_URI=mongodb://localhost:27017/biosoft

# --- Broker MQTT ---
# Desarrollo: el Mosquitto del compose, sin TLS ni credenciales.
#   MQTT_URL=mqtt://localhost:1883
# Produccion: el mismo EMQX al que publica la placa (ver secrets.h).
#   MQTT_URL=mqtts://xxxxxxxx.ala.sa-east-1.emqxsl.com:8883
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
# OJO: tiene que ser DISTINTO del clientId de la placa y distinto entre local y
# produccion. Dos clientes con el mismo clientId se desconectan mutuamente en
# un bucle que desde afuera parece "el broker anda mal".
MQTT_CLIENT_ID=biosoft-backend-dev
# Ruta al .crt descargado de la consola de EMQX. Vacio => se usa el almacen de
# CAs del sistema. Nunca deshabilitar la verificacion.
MQTT_CA_PATH=

# --- Equipo ---
# Hoy hay una sola placa y los topics no llevan identificador. Se guarda igual
# en cada documento para no tener que migrar la base el dia que haya dos.
DEVICE_ID=biosoft-01

# --- Topics (defaults compilados de esp32/src/topics.hpp) ---
# Los puede renombrar la tarjeta SD (seccion `telemetry` de config-schema.md).
# Si se renombran alla, hay que renombrarlos aca o el dato deja de llegar sin
# ningun error visible.
TOPIC_MEASURES=biosoft/telemetry/measures
TOPIC_COILS=biosoft/telemetry/coils
TOPIC_STATUS=biosoft/telemetry/status
TOPIC_TARGETS=biosoft/telemetry/targets
TOPIC_ALERTS=biosoft/telemetry/alerts
TOPIC_RESULT=biosoft/telemetry/result

# --- Nombres de campo configurables (los otros son estructurales) ---
FIELD_MAGNETIC=CEM1
FIELD_TEMPERATURE=TEMP1
FIELD_HEALTH=ESTADO
FIELD_PROGRESS=PROGRESS
FIELD_ELAPSED=ELAPSED_TIME

# --- Sesiones ---
# OBLIGATORIO en produccion. Sin esto se genera una clave al azar al arrancar,
# el servidor anda igual, pero cada reinicio (o cada despliegue) cierra todas
# las sesiones abiertas. Generar con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Primer usuario, creado SOLO si la base no tiene ninguno. No pisa cuentas ni
# contraseñas existentes, asi que dejarlo puesto no revierte un cambio hecho
# despues. Para crear o cambiar usuarios despues:
#   npm run usuario --workspace server -- <usuario> <contraseña>
SEED_USER=
SEED_PASSWORD=
